{
  "name": "@opensourcenepal/nepali-calendar",
  "version": "0.1.0",
  "description": "Nepali (Bikram Sambat) calendar for JavaScript: AD/BS conversion, validation, and Roman or Devanagari formatting.",
  "license": "MIT",
  "author": "contentxx",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unicodist/OSN.NepaliCalendar.git",
    "directory": "js/packages/core"
  },
  "homepage": "https://github.com/Unicodist/OSN.NepaliCalendar/tree/main/js/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Unicodist/OSN.NepaliCalendar/issues"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "calendar",
    "date"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
