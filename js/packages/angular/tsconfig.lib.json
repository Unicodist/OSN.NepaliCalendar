{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "dist/out-tsc"
