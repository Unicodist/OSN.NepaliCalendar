{
  "name": "@opensourcenepal/nepali-calendar-angular",
  "version": "1.1.1",
  "description": "Angular month-view calendar and date picker for Nepali (Bikram Sambat) dates, with AD dates alongside.",
  "license": "MIT",
  "author": "contentxx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unicodist/OSN.NepaliCalendar.git",
    "directory": "js/packages/angular"
  },
  "homepage": "https://github.com/Unicodist/OSN.NepaliCalendar/tree/main/js/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/Unicodist/OSN.NepaliCalendar/issues"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "calendar",
    "date-picker",
    "angular"
  ],
  "exports": {
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "cp ../core/styles.css styles.css && ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@opensourcenepal/nepali-calendar": "^1.1.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.8.0",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular/animations": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@storybook/angular": "^10.6.1",
    "jsdom": "^27.0.0",
    "ng-packagr": "^22.2.0",
    "rxjs": "^7.8.2",
    "storybook": "^10.6.1",
    "vite": "^8.3.4"
  }
}
